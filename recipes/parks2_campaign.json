{
  "name": "parks2_kumamoto_op18",
  "_note": "Recipe thật, dò từ site ngày 2026-11-14. Luồng: login form Parks2 -> trang item -> đóng popup 本人確認 -> chọn 種類/数量 -> カートに入れる -> 購入手続きに進む -> cart_index -> cart_seisan (ご注文情報入力) -> PAUSE (để người dùng tự điền địa chỉ/thanh toán). Đổi ngày giờ nhận hàng ở bước 'chọn ngày/giờ' (PRIORITY_ITEMPROPERTY_CD_MATRIX_0) hoặc dùng --slot ở CLI.",
  "login": {
    "url": "https://parks2.bandainamco-am.co.jp/login.html?request=redirect_logon&redirectTo=member_mypage.html",
    "logged_in_selector": "a[href*=\"request=logoff\"]",
    "logged_out_selector": "a[href$=\"/login.html\"]",
    "password_selector": "#PASSWORD",
    "steps": [
      {
        "name": "đóng banner cookie",
        "action": "dismiss",
        "selectors": ["#onetrust-accept-btn-handler", "#onetrust-reject-all-handler"]
      },
      {
        "name": "chờ form đăng nhập",
        "action": "wait_selector",
        "selector": "#LOGINID"
      },
      {
        "name": "điền email",
        "action": "fill",
        "selector": "#LOGINID",
        "value": "{email}"
      },
      {
        "name": "điền mật khẩu",
        "action": "fill",
        "selector": "#PASSWORD",
        "value": "{password}"
      },
      {
        "name": "bấm đăng nhập",
        "action": "click",
        "selector": "input[type=submit][value=\"ログイン\"]"
      },
      {
        "name": "chờ đăng nhập xong",
        "action": "wait_selector",
        "selector": "a[href*=\"request=logoff\"]",
        "timeout": 25000
      }
    ]
  },
  "entry": {
    "steps": [
      {
        "name": "xoá giỏ cũ (khi đổi khung giờ)",
        "action": "clear_cart",
        "value": "https://parks2.bandainamco-am.co.jp/cart_index.html",
        "selector": "a[onclick*=\"'delete'\"]"
      },
      {
        "name": "đóng popup 本人確認書類 (tick 内容確認しました rồi bấm 閉じる)",
        "action": "dismiss",
        "check": "#confirmCheck",
        "selectors": ["#closePopupButton"]
      },
      {
        "name": "chờ form chọn 種類",
        "action": "wait_selector",
        "selector": "#PRIORITY_ITEMPROPERTY_CD_MATRIX_0"
      },
      {
        "name": "chọn ngày/giờ (11/21 11:00)",
        "action": "select",
        "selector": "#PRIORITY_ITEMPROPERTY_CD_MATRIX_0",
        "value": "159016_1121_1100_1"
      },
      {
        "name": "số lượng = 1",
        "action": "select",
        "selector": "#CART_AMOUNT_0",
        "value": "1"
      },
      {
        "name": "ảnh màn hình trước khi thêm giỏ",
        "action": "screenshot",
        "value": "before-cart",
        "optional": true
      },
      {
        "name": "bấm カートに入れる",
        "action": "click",
        "selector": "#addCart"
      },
      {
        "name": "chờ popup thêm giỏ",
        "action": "wait_selector",
        "selector": "a:has-text(\"購入手続きに進む\")",
        "timeout": 20000
      },
      {
        "name": "bấm 購入手続きに進む",
        "action": "click",
        "selector": "a:has-text(\"購入手続きに進む\")"
      },
      {
        "name": "chờ trang giỏ hàng",
        "action": "wait_selector",
        "selector": "a[onclick*=\"cart_seisan.html\"]",
        "timeout": 25000
      },
      {
        "name": "ảnh màn hình giỏ hàng",
        "action": "screenshot",
        "value": "cart",
        "optional": true
      },
      {
        "name": "sang trang nhập thông tin đơn",
        "action": "click",
        "selector": "a[onclick*=\"cart_seisan.html\"]"
      },
      {
        "name": "chờ trang ご注文情報入力",
        "action": "wait_text",
        "value": "ご依頼主（ご請求先）情報",
        "timeout": 25000
      },
      {
        "name": "họ (姓) nếu trống",
        "action": "fill",
        "selector": "#L_NAME",
        "value": "{l_name}",
        "when": "{l_name}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "tên (名) nếu trống",
        "action": "fill",
        "selector": "#F_NAME",
        "value": "{f_name}",
        "when": "{f_name}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "họ kana nếu trống",
        "action": "fill",
        "selector": "#L_KANA",
        "value": "{l_kana}",
        "when": "{l_kana}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "tên kana nếu trống",
        "action": "fill",
        "selector": "#F_KANA",
        "value": "{f_kana}",
        "when": "{f_kana}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "mã bưu điện",
        "action": "fill",
        "selector": "#ZIP",
        "value": "{zip}",
        "when": "{zip}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "bấm 〒反映 để tra địa chỉ theo mã bưu điện",
        "action": "click",
        "selector": "input[type=button][value=\"〒反映\"]",
        "when": "{zip}",
        "optional": true
      },
      {
        "name": "tỉnh/thành (都道府県)",
        "action": "select",
        "selector": "#ADDR1",
        "value": "{pref}",
        "when": "{pref}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "quận/huyện (市区町村)",
        "action": "fill",
        "selector": "#ADDR2",
        "value": "{city}",
        "when": "{city}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "số nhà (丁目・番地)",
        "action": "fill",
        "selector": "input[name=\"ORDER_H.FREE_ITEM12\"]",
        "value": "{street}",
        "when": "{street}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "toà nhà / số phòng",
        "action": "fill",
        "selector": "input[name=\"ADDR3\"]",
        "value": "{building}",
        "when": "{building}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "tick ビル・マンション名・部屋番号なし (khi chưa có tên toà nhà)",
        "action": "check",
        "selector": "input[name=\"ORDER_H.FREE_ITEM22\"]",
        "only_if_empty": "input[name=\"ADDR3\"]",
        "optional": true
      },
      {
        "name": "điện thoại di động",
        "action": "fill",
        "selector": "#TEL",
        "value": "{tel}",
        "when": "{tel}",
        "only_if_empty": true,
        "optional": true
      },
      {
        "name": "ảnh màn hình trang thông tin đơn",
        "action": "screenshot",
        "value": "order-info",
        "optional": true
      },
      {
        "name": "dừng ở bước thanh toán (chỉ khi TẮT tự bấm gửi)",
        "action": "pause",
        "unless_submit": true
      },
      {
        "name": "sang trang xác nhận ご注文情報確認",
        "action": "click",
        "selector": "input[type=submit][value=\"入力内容を確認する\"]",
        "requires_submit": true
      },
      {
        "name": "chờ trang xác nhận",
        "action": "wait_text",
        "value": "ご注文情報確認",
        "requires_submit": true,
        "timeout": 25000
      },
      {
        "name": "ảnh màn hình trang xác nhận",
        "action": "screenshot",
        "value": "confirm",
        "requires_submit": true,
        "optional": true
      },
      {
        "name": "bấm 注文する (chốt đơn)",
        "action": "submit",
        "selector": "#order_now_btn",
        "requires_submit": true
      },
      {
        "name": "chờ trang ご注文完了",
        "action": "wait_text",
        "value": "ご注文完了",
        "requires_submit": true,
        "timeout": 30000,
        "optional": true
      }
    ]
  },
  "verification": {
    "success_text": ["ご注文完了", "ご注文ありがとうございました", "注文を承りました", "受付が完了"],
    "already_text": ["すでにお申し込み", "既にお申し込み", "重複", "購入済み"],
    "closed_text": ["受付期間外", "受付を終了", "販売期間外"],
    "error_text": ["エラーが発生", "アクセスが集中", "画面操作の誤り"]
  }
}


