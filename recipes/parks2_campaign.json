{
  "name": "parks2_kumamoto_op18",
  "_note": "Recipe thật, dò từ site ngày 2026-11-14. Luồng: login form Parks2 -> trang item -> đóng popup 本人確認 -> chọn 種類/数量 -> カートに入れる -> 購入手続きに進む -> cart_index -> cart_seisan (ご注文情報入力) -> PAUSE (để người dùng tự điền địa chỉ/thanh toán). Đổi ngày giờ nhận hàng ở bước 'chọn ngày/giờ' (PRIORITY_ITEMPROPERTY_CD_MATRIX_0) hoặc dùng --slot ở CLI.",
  "login": {
    "url": "https://parks2.bandainamco-am.co.jp/login.html?request=redirect_logon&redirectTo=member_mypage.html",
    "logged_in_selector": "a[href*=\"request=logoff\"]",
    "logged_out_selector": "a[href$=\"/login.html\"]",
    "password_selector": "#PASSWORD",
    "steps": [
      {
        "name": "đóng banner cookie",
        "action": "dismiss",
        "selectors": ["#onetrust-accept-btn-handler", "#onetrust-reject-all-handler"]
      },
      {
        "name": "chờ form đăng nhập",
        "action": "wait_selector",
        "selector": "#LOGINID"
      },
      {
        "name": "điền email",
        "action": "fill",
        "selector": "#LOGINID",
        "value": "{email}"
      },
      {
        "name": "điền mật khẩu",
        "action": "fill",
        "selector": "#PASSWORD",
        "value": "{password}"
      },
      {
        "name": "bấm đăng nhập",
        "action": "click",
        "selector": "input[type=submit][value=\"ログイン\"]"
      },
      {
        "name": "chờ đăng nhập xong",
        "action": "wait_selector",
        "selector": "a[href*=\"request=logoff\"]",
        "timeout": 25000
      }
    ]
  },
  "entry": {
    "steps": [
      {
        "name": "đóng popup 本人確認書類 (tick 内容確認しました rồi bấm 閉じる)",
        "action": "dismiss",
        "check": "#confirmCheck",
        "selectors": ["#closePopupButton"]
      },
      {
        "name": "chờ form chọn 種類",
        "action": "wait_selector",
        "selector": "#PRIORITY_ITEMPROPERTY_CD_MATRIX_0"
      },
      {
        "name": "chọn ngày/giờ (11/21 11:00)",
        "action": "select",
        "selector": "#PRIORITY_ITEMPROPERTY_CD_MATRIX_0",
        "value": "159016_1121_1100_1"
      },
      {
        "name": "số lượng = 1",
        "action": "select",
        "selector": "#CART_AMOUNT_0",
        "value": "1"
      },
      {
        "name": "ảnh màn hình trước khi thêm giỏ",
        "action": "screenshot",
        "value": "before-cart",
        "optional": true
      },
      {
        "name": "bấm カートに入れる",
        "action": "click",
        "selector": "#addCart"
      },
      {
        "name": "chờ popup thêm giỏ",
        "action": "wait_selector",
        "selector": "a:has-text(\"購入手続きに進む\")",
        "timeout": 20000
      },
      {
        "name": "bấm 購入手続きに進む",
        "action": "click",
        "selector": "a:has-text(\"購入手続きに進む\")"
      },
      {
        "name": "chờ trang giỏ hàng",
        "action": "wait_selector",
        "selector": "a[onclick*=\"cart_seisan.html\"]",
        "timeout": 25000
      },
      {
        "name": "ảnh màn hình giỏ hàng",
        "action": "screenshot",
        "value": "cart",
        "optional": true
      },
      {
        "name": "sang trang nhập thông tin đơn",
        "action": "click",
        "selector": "a[onclick*=\"cart_seisan.html\"]"
      },
      {
        "name": "chờ trang ご注文情報入力",
        "action": "wait_text",
        "value": "ご依頼主（ご請求先）情報",
        "timeout": 25000
      },
      {
        "name": "dừng ở bước điền thông tin thanh toán (để cửa sổ lại cho người dùng)",
        "action": "pause"
      }
    ]
  },
  "verification": {
    "success_text": ["ご注文完了", "お申し込みを受け付けました", "受付が完了"],
    "already_text": ["すでにお申し込み", "既にお申し込み", "重複"],
    "closed_text": ["受付期間外", "受付を終了"],
    "error_text": ["エラーが発生", "アクセスが集中"]
  }
}
